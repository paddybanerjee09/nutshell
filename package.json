{
  "name": "nutshell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "alpha:setup": "node scripts/alpha.ts setup",
    "alpha:dev": "node scripts/alpha.ts dev",
    "alpha:verify": "node scripts/alpha.ts verify",
    "alpha:reset": "node scripts/alpha.ts reset",
    "alpha:stop": "node scripts/alpha.ts stop",
    "lint": "eslint .",
    "typecheck": "tsc && pnpm --filter @nutshell/web typecheck",
    "test": "vitest run",
    "nutshell": "node packages/cli/src/main.ts"
  },
  "dependencies": {
    "@nutshell/server": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.4",
    "eslint": "10.15.0",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
